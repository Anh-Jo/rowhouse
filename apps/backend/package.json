{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "check-types": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "database:generate-migration": "npx prisma migrate dev --name ",
    "database:generate-migration:auth": "npx prisma migrate dev --config prisma.auth.config.ts --name ",
    "database:generate-schema:auth": "npx @better-auth/cli generate --config src/auth/auth.cli.ts --output prisma/auth/schema.prisma --yes",
    "database:studio": "npx prisma studio",
    "database:generate": "npx prisma generate && npx prisma generate --config prisma.auth.config.ts",
    "database:migrate": "npx prisma migrate deploy && npx prisma migrate deploy --config prisma.auth.config.ts",
    "database:migrate:test": "dotenv -e .env.test -- npx prisma migrate deploy",
    "database:migrate:test:auth": "dotenv -e .env.test -- npx prisma migrate deploy --config prisma.auth.config.ts",
    "contracts:export": "nest build && node -r tsconfig-paths/register -e \"require('./dist/scripts/generate-contracts')\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.0.0",
    "@google-cloud/cloud-sql-connector": "^1.11.3",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "jest": "^30.3.0",
    "pglite-prisma-adapter": "^0.7.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!generated/**",
      "!**/*.module.ts",
      "!**/*.spec.ts",
      "!**/*.d.ts",
      "!test-utils/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 45,
        "branches": 32,
        "functions": 40,
        "lines": 45
      },
      "./src/config/": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      }
    },
    "testEnvironment": "node"
  }
}
