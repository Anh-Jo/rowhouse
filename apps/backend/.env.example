# PostgreSQL connection string (matches the dev container — see infra/compose.dev.yml)
DATABASE_URL=postgresql://starter:starter@localhost:3010/starter

# HTTP port the API listens on (default: 3000)
# PORT=3000

# Frontend URL (used for CORS and links in emails)
FRONTEND_URL=http://localhost:5173

# Trust X-Forwarded-For headers from a front proxy (enable in prod behind a
# reverse proxy so rate limiting keys on the real client IP). Default: false.
# TRUST_PROXY=true

# SMTP (Mailpit in dev — UI: http://localhost:3021)
SMTP_HOST=localhost
SMTP_PORT=3020
SMTP_SECURE=false
MAIL_FROM=noreply@starter.local

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug
