# PostgreSQL connection string (matches the dev container — see infra/compose.dev.yml)
DATABASE_URL=postgresql://rowhouse:rowhouse@localhost:3010/rowhouse

# better-auth database (same Postgres instance, separate database — created on
# a fresh dev volume by infra/create-auth-db.sql)
AUTH_DATABASE_URL=postgresql://rowhouse:rowhouse@localhost:3010/rowhouse_auth

# better-auth: session/token signing secret (min 32 chars) + public base URL
BETTER_AUTH_SECRET=change-me-to-a-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# HTTP port the API listens on (default: 3000)
# PORT=3000

# Frontend URL (used for CORS and links in emails)
FRONTEND_URL=http://localhost:5173

# Trust X-Forwarded-For headers from a front proxy (enable in prod behind a
# reverse proxy so rate limiting keys on the real client IP). Default: false.
# TRUST_PROXY=true

# Google SSO — enabled only when BOTH are set. Create the OAuth client in the
# Google Cloud Console, then fill these in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP (Mailpit in dev — UI: http://localhost:3021)
SMTP_HOST=localhost
SMTP_PORT=3020
SMTP_SECURE=false
MAIL_FROM=noreply@rowhouse.local

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug
