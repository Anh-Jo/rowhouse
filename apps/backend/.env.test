# Test stack: use docker compose -f docker/compose.test.yml up -d (from repo root)

# PostgreSQL (test container, port 4010)
DATABASE_URL=postgresql://rowhouse:rowhouse@localhost:4010/rowhouse

# better-auth database (test container) + signing secret / base URL.
# e2e run on PGlite (AuthPrismaService is overridden), so these only need to be
# present and valid — no live connection is opened against them.
AUTH_DATABASE_URL=postgresql://rowhouse:rowhouse@localhost:4010/rowhouse_auth
BETTER_AUTH_SECRET=test-better-auth-secret-0123456789abcdef
CREDENTIALS_KEK=cm93aG91c2UtdGVzdC1rZWstMTIzNDU2Nzg5YWJjZCE=
BETTER_AUTH_URL=http://localhost:3000

# Frontend (redirects and links in emails)
FRONTEND_URL=http://localhost:5173

# Mailpit test (SMTP 4020, UI 4021)
SMTP_HOST=localhost
SMTP_PORT=4020
SMTP_SECURE=false
MAIL_FROM=noreply@rowhouse.local

# Mailpit API base URL (used by e2e tests to read/delete messages)
MAILPIT_API=http://localhost:4021/api/v1
