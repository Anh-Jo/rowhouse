# Production stack configuration.
# Copy to infra/.env (auto-loaded by docker compose):
#   cp infra/.env.prod.example infra/.env

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=rowhouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rowhouse

# ── Public URLs (what the browser sees) ──────────────────
# Used for CORS on the API and links in emails
FRONTEND_URL=https://app.example.com
# Baked into the webapp bundle at build time
VITE_API_URL=https://api.example.com

# ── better-auth ──────────────────────────────────────────
# Session/token signing secret (min 32 chars — generate a random one)
BETTER_AUTH_SECRET=change-me-to-a-random-string-min-32-chars
# Public base URL of the API (used to build auth links)
BETTER_AUTH_URL=https://api.example.com
# Google SSO — enabled only when BOTH are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Host ports ───────────────────────────────────────────
API_PORT=3000
WEBAPP_PORT=8080
GRAFANA_PORT=5030

# ── Monitoring ───────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ── Logging (trace | debug | info | warn | error | fatal) ─
LOG_LEVEL=info

# ── Proxy ────────────────────────────────────────────────
# Enable when the API sits behind a reverse proxy (Traefik, nginx, Coolify…)
# so rate limiting keys on the real client IP from X-Forwarded-For.
# TRUST_PROXY=true

# ── SMTP (optional — mail falls back to a stream transport when unset) ─
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@example.com
