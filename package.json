{
  "name": "rowhouse",
  "private": true,
  "scripts": {
    "setup": "pnpm install && pnpm docker:dev && pnpm db:migrate && pnpm db:generate && pnpm codegen",
    "db:migrate": "pnpm --filter backend run database:migrate",
    "db:generate": "pnpm --filter backend run database:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "codegen": "pnpm --filter backend run contracts:export && pnpm --filter webapp run api:generate",
    "knip": "knip",
    "verify": "pnpm codegen && turbo run check-types lint test && knip",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag",
    "docker:dev": "docker compose -f infra/compose.dev.yml up -d --wait",
    "docker:test": "docker compose -f infra/compose.test.yml up -d",
    "docker:monitoring": "docker compose -f infra/compose.monitoring.yml up -d",
    "docker:prod": "docker compose -f infra/compose.prod.yml up -d --build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "knip": "^6.27.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "ws": ">=8.21.1",
      "fast-uri": ">=3.1.2"
    }
  }
}
